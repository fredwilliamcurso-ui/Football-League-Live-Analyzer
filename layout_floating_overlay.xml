<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- 1. MINIMIZED CIRCULAR FLOATING BUBBLE -->
    <RelativeLayout
        android:id="@+id/containerMinimized"
        android:layout_width="66dp"
        android:layout_height="66dp"
        android:visibility="gone">

        <!-- Glowing Cyan Circular Container -->
        <LinearLayout
            android:id="@+id/bubbleCircle"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentStart="true"
            android:background="@drawable/bg_bubble_circle"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Football Icon -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚽"
                android:textSize="18sp" />

            <!-- LIVE / WAIT Text -->
            <TextView
                android:id="@+id/bubbleLiveText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIVE"
                android:textColor="#00E5FF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />
        </LinearLayout>

        <!-- Top Right Amber Badge (Timer Countdown e.g. 24) -->
        <TextView
            android:id="@+id/bubbleBadgeTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:background="@drawable/bg_badge_amber"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:text="24"
            android:textColor="#000000"
            android:textSize="10sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- 2. EXPANDED HUD PANEL -->
    <LinearLayout
        android:id="@+id/containerExpanded"
        android:layout_width="310dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_hud_panel"
        android:padding="10dp"
        android:elevation="8dp">

        <!-- Top Drag Header Bar -->
        <LinearLayout
            android:id="@+id/overlayHeader"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚽"
                android:textSize="14sp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="FOOTBALL ANALYZER"
                android:textColor="#F8FAFC"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/btnMinimizeOverlay"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:gravity="center"
                android:text="⤢"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/btnCloseOverlay"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:gravity="center"
                android:text="✕"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- REAL-TIME DIAGNOSTIC TELEMETRY STRIP -->
        <LinearLayout
            android:id="@+id/panelDiagnostics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#0A101D"
            android:padding="6dp"
            android:layout_marginTop="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/diagBoomplay"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="BOOMPLAY: DETECTED"
                    android:textColor="#34D399"
                    android:textSize="8.5sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/diagGame"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GAME: DETECTED"
                    android:textColor="#34D399"
                    android:textSize="8.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="2dp">
                <TextView
                    android:id="@+id/diagScreenState"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SCREEN STATE: FOOTBALL_LEAGUE_GAME"
                    android:textColor="#38BDF8"
                    android:textSize="8.5sp" />
                <TextView
                    android:id="@+id/diagClock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CLOCK: 24s"
                    android:textColor="#FBBF24"
                    android:textSize="8.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="2dp">
                <TextView
                    android:id="@+id/diagRoundId"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ROUND ID: 08200035"
                    android:textColor="#94A3B8"
                    android:textSize="8.5sp" />
                <TextView
                    android:id="@+id/diagPhase"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PHASE: BETTING_COUNTDOWN"
                    android:textColor="#A78BFA"
                    android:textSize="8.5sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="2dp">
                <TextView
                    android:id="@+id/diagResult"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="RESULT: UNKNOWN"
                    android:textColor="#94A3B8"
                    android:textSize="8.5sp" />
                <TextView
                    android:id="@+id/diagPipelines"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MP: ACTIVE | OCR: ACTIVE | FP: ACTIVE"
                    android:textColor="#10B981"
                    android:textSize="7.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- FINAL MODEL DECISION CARD (Display Only) -->
        <LinearLayout
            android:id="@+id/cardDecision"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_decision_card"
            android:padding="8dp"
            android:layout_marginTop="6dp">

            <!-- Title & Model Score Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="✨ FINAL MODEL DECISION"
                    android:textColor="#34D399"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/badgeModelScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6-SIGNAL MODEL"
                    android:textColor="#047857"
                    android:textSize="8sp"
                    android:background="#064E3B"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp" />
            </LinearLayout>

            <!-- Main Top Pick Hero Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <!-- Team Icon Placeholder -->
                <TextView
                    android:id="@+id/iconTeam"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="#000000"
                    android:gravity="center"
                    android:text="⚽"
                    android:textSize="16sp"
                    android:layout_marginEnd="8dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Top Pick:"
                        android:textColor="#10B981"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/textTopPick"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Real Madrid"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textMultiplier"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Multiplier: X2.1"
                        android:textColor="#FBBF24"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Model Score:"
                        android:textColor="#94A3B8"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/textModelScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="82.8"
                        android:textColor="#2DD4BF"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Second and Third Picks -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#0A161E"
                android:padding="4dp"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/textSecondPick"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Second: Paris SG 80.7"
                    android:textColor="#94A3B8"
                    android:textSize="9sp"
                    android:gravity="center" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="12dp"
                    android:background="#1E293B" />

                <TextView
                    android:id="@+id/textThirdPick"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Third: Bayern Munich 78.1"
                    android:textColor="#94A3B8"
                    android:textSize="9sp"
                    android:gravity="center" />
            </LinearLayout>

            <!-- Status & Source Footer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/textModelStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Status: ACTIVE MODEL"
                    android:textColor="#34D399"
                    android:textSize="8sp" />

                <TextView
                    android:id="@+id/textSourceStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Source: REAL BOOMPLAY SCREEN"
                    android:textColor="#38BDF8"
                    android:textSize="8sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom Action Bar (Stop Monitoring Only) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/btnStopMonitoring"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:background="#2E1065"
                android:gravity="center"
                android:text="STOP LIVE OBSERVER"
                android:textColor="#F43F5E"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
