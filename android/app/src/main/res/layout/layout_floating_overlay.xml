<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- Expanded Floating Card -->
    <LinearLayout
        android:id="@+id/containerExpanded"
        android:layout_width="270dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F00F172A"
        android:padding="8dp">

        <!-- Draggable Title Bar -->
        <LinearLayout
            android:id="@+id/overlayHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#1E293B"
            android:padding="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚽ FOOTBALL ANALYZER (HUD)"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnMinimizeOverlay"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_crop"
                android:tint="#94A3B8" />

            <ImageButton
                android:id="@+id/btnCloseOverlay"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="#EF4444" />
        </LinearLayout>

        <!-- Source / Screen Connection Status Strip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#0284C7"
            android:padding="4dp"
            android:layout_marginTop="3dp">

            <TextView
                android:id="@+id/textSourceStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SOURCE: WAITING FOR REAL BOOMPLAY FRAME"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:gravity="center" />
        </LinearLayout>

        <!-- Game State & Live Clock Strip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp"
            android:layout_marginTop="3dp">

            <TextView
                android:id="@+id/textGameStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="GAME: NOT DETECTED"
                android:textColor="#F87171"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CLOCK: WAITING"
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Round Number Strip -->
        <TextView
            android:id="@+id/textRoundId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ROUND: WAITING FOR SYNC"
            android:textColor="#94A3B8"
            android:textSize="9sp"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="2dp" />

        <!-- Final Model Decision Card (Display-Only) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E293B"
            android:padding="6dp"
            android:layout_marginTop="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="DISPLAY-ONLY 6-SIGNAL MODEL"
                    android:textColor="#34D399"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textModelStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CALCULATING"
                    android:textColor="#38BDF8"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/textTopPick"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Waiting for real game frame..."
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/textTop2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. Waiting | 3. Waiting"
                android:textColor="#94A3B8"
                android:textSize="9sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Minimized Bubble -->
    <FrameLayout
        android:id="@+id/containerMinimized"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="#10B981"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚽"
            android:textSize="18sp"
            android:layout_gravity="center" />
    </FrameLayout>

</FrameLayout>
