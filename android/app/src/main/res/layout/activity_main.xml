<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#0F172A"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚽ Football League Analyzer"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="32dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Real-Screen Master Clock &amp; Prediction Engine"
        android:textColor="#94A3B8"
        android:textSize="13sp"
        android:layout_marginTop="4dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1E293B"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/textStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status: Initializing permissions..."
        android:textColor="#E2E8F0"
        android:textSize="14sp"
        android:background="#1E293B"
        android:padding="16dp"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnGrantOverlayPermission"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Grant Overlay Permission"
        android:backgroundTint="#3B82F6"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnToggleOverlay"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Start Live Screen Observer"
        android:backgroundTint="#10B981"
        android:textColor="#FFFFFF" />

</LinearLayout>
