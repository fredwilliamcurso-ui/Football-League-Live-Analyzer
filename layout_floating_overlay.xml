<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- Expanded Floating Card -->
    <LinearLayout
        android:id="@+id/containerExpanded"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#E60F172A"
        android:padding="8dp">

        <!-- Draggable Title Bar -->
        <LinearLayout
            android:id="@+id/overlayHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#1E293B"
            android:padding="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚽ FOOTBALL ANALYZER"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnMinimizeOverlay"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_crop"
                android:tint="#94A3B8" />

            <ImageButton
                android:id="@+id/btnCloseOverlay"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="#EF4444" />
        </LinearLayout>

        <!-- Live Clock & Status Strip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="6dp"
            android:layout_marginTop="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CLOCK: SYNCED"
                android:textColor="#10B981"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏱ 24s"
                android:textColor="#F59E0B"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Final Model Decision Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E293B"
            android:padding="8dp"
            android:layout_marginTop="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FINAL MODEL DECISION"
                android:textColor="#34D399"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textTopPick"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Manchester Utd (X4)"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/textTop2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. Juventus (X4) | 3. AC Milan (X6)"
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Minimized Bubble -->
    <FrameLayout
        android:id="@+id/containerMinimized"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="#10B981"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚽"
            android:textSize="18sp"
            android:layout_gravity="center" />
    </FrameLayout>

</FrameLayout>
