<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#0F172A"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚽ Football League Analyzer"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Real-Screen Master Clock &amp; Prediction Engine"
        android:textColor="#94A3B8"
        android:textSize="13sp"
        android:layout_marginTop="4dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1E293B"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/textStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ready: Tap 'START LIVE SCREEN OBSERVER' below to launch HUD."
        android:textColor="#E2E8F0"
        android:textSize="14sp"
        android:lineSpacingExtra="4dp"
        android:background="#1E293B"
        android:padding="16dp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnGrantOverlayPermission"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="Grant Overlay Permission"
        android:backgroundTint="#3B82F6"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true"
        android:onClick="onGrantOverlayClicked"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnToggleOverlay"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:text="START LIVE SCREEN OBSERVER"
        android:backgroundTint="#10B981"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="15sp"
        android:clickable="true"
        android:focusable="true"
        android:onClick="onStartObserverClicked"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnOpenBoomplay"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="OPEN BOOMPLAY FOOTBALL"
        android:backgroundTint="#6366F1"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true"
        android:onClick="onOpenBoomplayClicked"
        android:layout_marginBottom="12dp" />

</LinearLayout>

